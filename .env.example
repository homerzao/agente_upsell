# agente_upsell — valores reais SÓ no /opt/agente_upsell/.env do servidor (fora do git).
# Nunca commitar segredos. Ver docs/SETUP.md.

# App
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
APP_DOMAIN=upsell.exemplo.com.br
# Domínios de CLIENTE da página do PIX (só /pix e /marca). Podem ser vários:
# quem já recebeu um link continua funcionando pra sempre — nunca remova um.
APP_DOMAIN_2=hidrabene.techecom.com.br
APP_DOMAIN_3=ticket.hidrabene.com.br
# Base dos links que vão pro cliente ({PUBLIC_URL}/pix/{token}) — o domínio da
# marca em uso HOJE. Trocar aqui muda o link novo; os antigos seguem no ar.
PUBLIC_URL=https://ticket.hidrabene.com.br
POSTGRES_PASSWORD=trocar

# Interno (segurança)
BACKEND_TOKEN=trocar-token-mestre
STATUS_TOKEN=trocar-token-somente-leitura-faturamento
SESSION_SECRET=trocar-segredo-sessao

# Painel (login)
ADMIN_USER=jorge
# bcrypt hash da senha (gerar com: node -e "console.log(require('bcryptjs').hashSync('SENHA', 12))")
ADMIN_PASS_HASH=

# Meta WhatsApp Cloud API
METAWA_TOKEN=
METAWA_PHONE_ID=
METAWA_WABA_ID=
METAWA_VERIFY_TOKEN=
# Opcional: valida X-Hub-Signature-256 do webhook quando presente
META_APP_SECRET=

# Chatwoot (TechSAC, self-hosted)
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_INBOX_ID=
# Opcional: id do usuário-agente IA (atribuição) e do time humano (handoff)
CHATWOOT_AGENT_ID=
CHATWOOT_TEAM_ID=

# Yampi
YAMPI_ALIAS=
YAMPI_TOKEN=
YAMPI_SECRET=

# Pagar.me v5
PAGARME_SECRET_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# custo por 1M tokens (pro relatório de custo por venda); 0 = não calcular
OPENAI_PRECO_INPUT_1M=0
OPENAI_PRECO_OUTPUT_1M=0

# Operação (defaults seguros: test + CPF do Jorge)
WA_FONE_TESTE=5591992148793
WA_UPSELL_TEMPLATE_CONFIRMA=confirma_pedido_up
# flow v6 (data_exchange); no cutover vira o v7 (mesmo JSON, endpoint novo)
WA_UPSELL_FLOW_ID=3548925675262517
WA_UPSELL_HEADER_MEDIA_ID=
WA_UPSELL_HEADER_URL=
WA_UPSELL_PIX_TTL_MIN=5
WA_UPSELL_CLOSE_MIN=10
# janela pré-aceite (min) — ERP libera ~28min; corrigir_sac usa as horas abaixo
WA_UPSELL_JANELA_MIN=25
WA_UPSELL_AUTO_CLOSE_HORAS=4

# Data channel do flow (v6+): chave privada RSA do NÚMERO (whatsapp_business_encryption).
# É a MESMA do agente_ecom (state flow_private_key) — NUNCA gerar par novo.
# PEM em uma linha com \n escapado, ou multi-linha se o runtime suportar.
FLOW_PRIVATE_KEY=
